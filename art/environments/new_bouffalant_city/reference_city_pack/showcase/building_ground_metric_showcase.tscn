[sub_resource type="Shader" id="Shader_metric_grid"]
code = "shader_type spatial;\nrender_mode cull_disabled;\n\nvarying vec2 metric_xz;\n\nvoid vertex() {\n    metric_xz = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xz;\n}\n\nfloat grid_line(vec2 point, float spacing, float width) {\n    vec2 cell = abs(fract(point / spacing - 0.5) - 0.5) / fwidth(point / spacing);\n    return 1.0 - min(min(cell.x, cell.y) / width, 1.0);\n}\n\nvoid fragment() {\n    float two_meter = grid_line(metric_xz, 2.0, 0.9);\n    float eight_meter = grid_line(metric_xz, 8.0, 1.25);\n    vec3 color = vec3(0.075, 0.09, 0.105);\n    color = mix(color, vec3(0.13, 0.18, 0.21), two_meter * 0.72);\n    color = mix(color, vec3(0.25, 0.55, 0.68), eight_meter * 0.82);\n    ALBEDO = color;\n    ROUGHNESS = 0.96;\n    METALLIC = 0.02;\n}"

