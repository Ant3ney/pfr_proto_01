[sub_resource type="Shader" id="Shader_checker"]
code = "shader_type spatial;

uniform vec4 color_a : source_color = vec4(0.18, 0.48, 0.29, 1.0);
uniform vec4 color_b : source_color = vec4(0.25, 0.58, 0.36, 1.0);
uniform float squares = 16.0;

void fragment() {
	vec2 tile = floor(UV * squares);
	float checker = mod(tile.x + tile.y, 2.0);
	ALBEDO = mix(color_a.rgb, color_b.rgb, checker);
	ROUGHNESS = 0.9;
}"

