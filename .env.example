# Copy these placeholders into production Netlify site environment variables.
# Use Functions-only scope when supported, and mark the URI and pepper secret.
# Never commit real database credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?appName=pfr-cloud-save
MONGODB_DATABASE=pfr_locomotion
CLOUD_SAVE_PEPPER=replace-with-at-least-32-random-characters
